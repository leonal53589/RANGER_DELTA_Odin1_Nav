Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Static Map
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.45
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Update Topic:
        Value: /global_costmap/costmap_updates
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.55
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Update Topic:
        Value: /local_costmap/costmap_updates
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Last Controller Plan
      Enabled: true
      Color: 0; 170; 90
      Line Style: Billboards
      Line Width: 0.025
      Offset:
        Z: 0.03
      Topic:
        Value: /controller_server/accepted_plan
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Planner Candidates
      Enabled: false
      Color: 220; 150; 35
      Line Style: Billboards
      Line Width: 0.015
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Path
      Name: Collision Check Arc
      Enabled: false
      Color: 255; 120; 20
      Line Style: Billboards
      Line Width: 0.025
      Offset:
        Z: 0.04
      Topic:
        Value: /lookahead_collision_arc
    - Class: rviz_default_plugins/Polygon
      Name: Base Footprint
      Enabled: true
      Color: 40; 125; 255
      Topic:
        Value: /local_costmap/published_footprint
    - Class: rviz_default_plugins/Odometry
      Name: Base Heading
      Enabled: true
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Value: Arrow
        Color: 40; 125; 255
        Shaft Length: 0.24
        Shaft Radius: 0.025
        Head Length: 0.13
        Head Radius: 0.065
      Covariance:
        Value: false
      Topic:
        Value: /odom
  Global Options:
    Background Color: 49; 51; 54
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: <Fixed Frame>
      Scale: 70
      X: 3.5
      Y: 0
Window Geometry:
  Width: 1100
  Height: 720
