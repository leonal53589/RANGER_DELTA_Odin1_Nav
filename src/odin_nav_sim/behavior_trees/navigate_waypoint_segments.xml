<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <WaypointSegments goals="{goals}" preview="{preview_path}" segment="{segment_goals}"
                      segment_goal="{segment_goal}">
      <Timeout msec="21000">
        <RecoveryNode number_of_retries="10" name="PreviewWaypointRoute">
          <ComputePathThroughPoses goals="{goals}" path="{preview_path}" planner_id="GridBased"/>
          <Wait wait_duration="2"/>
        </RecoveryNode>
      </Timeout>
      <ReactiveSequence>
        <RemovePassedGoals input_goals="{segment_goals}" output_goals="{segment_goals}" radius="0.7"/>
        <ObstacleNavigation goal="{segment_goal}" candidate="{candidate}" path="{path}"
                            goal_probe="{goal_probe}" prefix="{safe_prefix}">
          <ComputePathThroughPoses goals="{segment_goals}" path="{candidate}" planner_id="GridBased"/>
          <IsPathValid path="{path}"/>
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <IsPathValid path="{goal_probe}"/>
          <IsPathValid path="{safe_prefix}"/>
        </ObstacleNavigation>
      </ReactiveSequence>
    </WaypointSegments>
  </BehaviorTree>
</root>
