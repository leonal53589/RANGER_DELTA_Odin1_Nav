<root main_tree_to_execute="Station">
  <BehaviorTree ID="Station">
    <ReactiveSequence>
      <StationGoalPath goal="{goal}" station_path="{station_path}"/>
      <Sequence>
        <ObstacleNavigation goal="{goal}" candidate="{candidate}" path="{path}" goal_probe="{goal_probe}"
                            prefix="{safe_prefix}" yield_seconds="2.0" blocked_seconds="20.0">
          <ComputePathToPose goal="{goal}" path="{candidate}" planner_id="GridBased"/>
          <IsPathValid path="{path}"/>
          <FollowPath path="{path}" controller_id="FollowPath" server_timeout="100"/>
          <IsPathValid path="{goal_probe}"/>
          <IsPathValid path="{safe_prefix}"/>
        </ObstacleNavigation>
        <FollowPath path="{station_path}" controller_id="StationAlign" goal_checker_id="goal_checker"/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>
</root>
